          "name": "Retry a bulk request",
          "request": {
            "name": "Retry a bulk request",
            "description": {
              "content": "Creates a new bulk request that re-runs only the parent's failed and skipped items. The new request's `parent_bulk_request_id` points at the original.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "bulk_requests",
                ":id",
                "retry"
