          "name": "Get bulk request status",
          "request": {
            "name": "Get bulk request status",
            "description": {
              "content": "Poll the status of an asynchronous bulk request. Returns the bulk request payload plus paginated per-row results. Results grow as processing continues, so only non-pending items are included.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "bulk_requests",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Number of result items to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset for result items"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The bulk request ID returned from POST /records/bulk"
