              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The ID of the failed or cancelled bulk request to retry"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
          "response": [
            {
              "id": "c7cb4e46-3aa8-4dce-840f-e62ee4bc55fb",
              "name": "Retry created and enqueued. Returns the **new** bulk request, not the parent.",
